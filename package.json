{
  "name": "ruddr-mcp",
  "version": "0.3.0",
  "type": "module",
  "description": "MCP server for the Ruddr PSA REST API (stdio, self-hosted).",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/index.ts",
    "gen:types": "openapi-typescript https://docs.ruddr.io/openapi.json -o src/generated/ruddr-openapi.d.ts",
    "lint": "echo \"(no linter yet)\"",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:ci": "npm run test && npm run test:integration",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "vitest": "^3.2.0",
    "openapi-typescript": "^7.9.0",
    "tsup": "^8.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0"
  }
}

